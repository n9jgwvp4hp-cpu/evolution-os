# ===========================================================
#  Evolution OS — Environment Variables
# ===========================================================
#
# 1. Copy this file and rename the copy to:  .env.local
# 2. Paste your OpenAI API key after the "=" sign below.
# 3. Save the file and restart the dev server.
#
# Get a key here: https://platform.openai.com/api-keys
# ===========================================================

OPENAI_API_KEY=sk-paste-your-real-key-here

# Optional: change the model (default is gpt-4o-mini, which is cheap & fast)
OPENAI_MODEL=gpt-4o-mini

# ===========================================================
#  Google integration (Gmail + Calendar) — OPTIONAL
# ===========================================================
# The CRM, pipeline, tasks, notes, memory and voice features all work
# WITHOUT this. Fill these in only if you want live Gmail & Calendar.
#
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth client ID → "Web application"
# 3. Enable the "Gmail API" and "Google Calendar API"
# 4. Add this Authorized redirect URI:
#       http://localhost:3000/api/google/callback
# 5. Paste the client ID + secret below and restart the dev server.
# ===========================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
